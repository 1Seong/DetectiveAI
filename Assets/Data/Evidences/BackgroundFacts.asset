  m_Script: {fileID: 11500000, guid: de9aef27708eab2409f5651d47c19e0a, type: 3}
  m_Name: BackgroundFacts
  m_EditorClassIdentifier: Assembly-CSharp::BackgroundFacts
  Facts:
  - "\uC058\uC559\uBE75\uC9D1\uC758 \uC0AC\uC7A5\uC774\uC790 \uC774\uBC88 \uC0AC\uAC74\uC758
    \uC758\uB8B0\uC778\uC778 '\uC058\uC559'\uC774 \uB2E4\uAE09\uD558\uAC8C  \uD0D0\uC815
    \uC0AC\uBB34\uC18C\uC5D0 \uB4E4\uC5B4\uC624\uBA70 \uB9D0\uD55C\uB2E4. \"\uC81C
    \uB808\uC2DC\uD53C \uB178\uD2B8\uAC00 \uC0AC\uB77C\uC84C\uB294\uB370, \uD558\uD544
    \uC694\uC998 \uB77C\uC774\uBC8C \uBE75\uC9D1 '\uC1FC\uCF5C\uB77C \uD398\uC2A4\uCE04\uB9AC'\uC5D0\uC11C
    \uC800\uD76C \uD669\uAE08\uBC14\uAC8C\uD2B8\uACFC \uD310\uBC15\uC774\uC778 \uC2E0\uBA54\uB274\uAC00
    \uB098\uC654\uC9C0 \uBB61\uB2C8\uAE4C!\"  \uC058\uC559\uBE75\uC9D1\uC758 \uC9C1\uC6D0\uC740
    \uBA38\uD540\uACFC \uBE0C\uB9AC\uC624\uC288 \uB450 \uBA85\uC774\uB2E4. \uBE0C\uB9AC\uC624\uC288\uAC00
    \uADFC\uBB34\uD558\uB294 \uC2DC\uAC04\uC5D0\uB294 \uC058\uC559\uB3C4 \uD56D\uC0C1
    \uADFC\uBB34\uD558\uAE30 \uB54C\uBB38\uC5D0 \uBE0C\uB9AC\uC624\uC288\uAC00 \uB808\uC2DC\uD53C
    \uB178\uD2B8\uB97C \uD6D4\uCCE4\uB2E4\uBA74 \uC058\uC559\uC774 \uC54C\uC544\uCC58\uC744
    \uAC83\uC774\uB2E4. \uC694\uC998 \uBA38\uD540\uC758 \uADFC\uBB34 \uD0DC\uB3C4\uAC00
    \uC88B\uC9C0 \uC54A\uB2E4.  \uC058\uC559\uC740 \uC0AC\uC6A9\uD55C \uBB3C\uAC74\uC744
    \uD56D\uC0C1 \uC81C\uC790\uB9AC\uC5D0 \uB454\uB2E4. \uB808\uC2DC\uD53C \uB178\uD2B8\uB294
    \uCC45\uC7A5\uC758 \uC67C\uCABD\uC5D0\uC11C \uB450 \uBC88\uC9F8, \uC704\uC5D0\uC11C
    \uC138 \uBC88\uC9F8 \uCE78\uC5D0 \uAF42\uC544\uB454\uB2E4.  <\uB4F1\uC7A5\uC778\uBB3C>
    \uC058\uC559: 50\uB300 \uB0A8\uC131, \uC058\uC559\uBE75\uC9D1 \uC0AC\uC7A5\uC774\uC790
    \uC758\uB8B0\uC778 \uBA38\uD540: 40\uB300 \uB0A8\uC131, \uC058\uC559\uBE75\uC9D1
    \uC8FC\uBC29 \uB2F4\uB2F9 \uC9C1\uC6D0 \uC1FC\uCF5C\uB77C: 40\uB300 \uC5EC\uC131,
    \uB77C\uC774\uBC8C \uBE75\uC9D1 \uC1FC\uCF5C\uB77C \uD398\uC2A4\uCE04\uB9AC \uC0AC\uC7A5,
    \uACFC\uAC70 \uC058\uC559\uBE75\uC9D1 \uADFC\uBB34 \uC774\uB825\uC774 \uC788\uC74C
    \uBE0C\uB9AC\uC624\uC288: 20\uB300 \uB0A8\uC131, \uC058\uC559\uC758 \uC870\uCE74,
    \uC058\uC559\uBE75\uC9D1 \uC9C1\uC6D0"
