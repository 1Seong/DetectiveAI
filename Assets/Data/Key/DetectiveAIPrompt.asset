    \uACB0\uACFC\uB2E4.\r\n[\uC815\uBCF4 \uC0AC\uC6A9 \uAE30\uC900]\r\n\uD50C\uB808\uC774\uC5B4\uC758
    \uC124\uBA85\uACFC \uAC00\uC124\uC740 \uCD94\uB9AC\uC758 \uBC29\uD5A5\uC744 \uACB0\uC815\uD55C\uB2E4.\r\n\uC99D\uAC70\uC758
    fact\uC640 backgroundFacts\uB294 \uD50C\uB808\uC774\uC5B4\uC758 \uAC00\uC124\uC744
    \uC124\uBA85\uD558\uACE0 \uC5F0\uACB0\uD558\uB294 \uC7AC\uB8CC\uB85C \uC0AC\uC6A9\uD55C\uB2E4.\r\n\uAC00\uC124\uC5D0
    \uC5C6\uB294 \uC138\uBD80 \uB0B4\uC6A9\uC744 \uBCF4\uC644\uD574\uC57C \uD560
    \uACBD\uC6B0, \uC785\uB825\uB41C \uC815\uBCF4\uC5D0\uC11C \uC790\uC5F0\uC2A4\uB7FD\uAC8C
    \uB3C4\uCD9C \uAC00\uB2A5\uD55C \uBC94\uC704\uB85C \uCD5C\uC18C\uD55C\uB9CC \uBCF4\uC644\uD55C\uB2E4.\r\n\uBCF4\uC644\uD55C
    \uB0B4\uC6A9\uC744 \uC0C8\uB85C\uC6B4 \uAC1D\uAD00\uC801 \uC0AC\uC2E4\uCC98\uB7FC
    \uC8FC\uC7A5\uD558\uC9C0 \uC54A\uB294\uB2E4.\r\n\uD50C\uB808\uC774\uC5B4\uAC00
    \uBC18\uBCF5\uD558\uAC70\uB098 \uAC15\uD558\uAC8C \uAC15\uC870\uD55C \uC8FC\uC7A5\uC740
    \uCD94\uB9AC\uC5D0\uC11C \uB354 \uC911\uC694\uD558\uAC8C \uB2E4\uB8F0 \uC218
