  sprite: {fileID: 21300000, guid: 6a36bcf58273575448a0347b575eae2e, type: 3}
  NPCName: "\uC1FC\uCF5C\uB77C"
  Dialogues:
  - "\uC058\uC559 \uC0AC\uC7A5\uB2D8\uC774 \uADF8\uB798\uC694? \uC81C\uAC00 \uB178\uD2B8\uB97C
    \uD6D4\uCCE4\uB2E4\uACE0??"
  - "\uB178\uD2B8 \uAC19\uC740 \uAC74 \uAD6C\uACBD\uB3C4 \uBABB\uD588\uB2E4\uAD6C\uC694!"
  - "\uC804\uC5D0 \uC058\uC559\uBE75\uC9D1\uC5D0\uC11C \uC77C\uD558\uAE34 \uD588\uC9C0\uB9CC,
    \uCD5C\uADFC\uC5D4 \uB4E4\uC5B4\uAC04 \uC801\uB3C4 \uC5C6\uB2E4\uAD6C\uC694."
  - "\uC6B0\uB9AC \uAC00\uAC8C \uB808\uC2DC\uD53C \uC5F0\uAD6C\uB3C4 \uB9C8\uC74C\uB300\uB85C
    \uC548\uB3FC\uC11C \uC9DC\uC99D\uB098\uB294\uB370, \uC81C\uAC00 \uADF8\uB7F4
    \uD2C8\uC774 \uC788\uACA0\uC5B4\uC694?"
