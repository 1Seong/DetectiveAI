--- !u!114 &1670121335
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1670121333}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ba67bac91b7dd11478b3b76a3c7b0e79, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AITest
  outputText: {fileID: 0}
  inputs1:
  - evidenceDatas:
    - {fileID: 11400000, guid: 9dd0f9f919c6a284ab81cb6486a7978e, type: 2}
    - {fileID: 11400000, guid: 1f68a7bd57d4e374db5019927f86d064, type: 2}
    - {fileID: 11400000, guid: 8a06f11de47e9dc4cb30e1c0cfb99c64, type: 2}
    - {fileID: 11400000, guid: 0073a29b9412ac44d81de21d562fa3af, type: 2}
    - {fileID: 11400000, guid: 6fb636ab9f40975458632b7274071248, type: 2}
    playerDescription: "\uC57D\uD63C\uB140\uAC00 \uBC24 10\uC2DC\uC5D0 \uC720\uC0B0\uC744
      \uB178\uB9AC\uACE0 \uCC3D\uBB38\uC744 \uAE68\uACE0 \uCE68\uC785\uD574  \uD2B8\uB85C\uD53C\uB85C
      \uBA38\uB9AC\uB97C \uB0B4\uB824\uCE5C\uAC70\uAC19\uC544\uC694. \uADF8\uB9AC\uACE0
      \uB3C8\uC744 \uBC14\uB2E5\uC5D0 \uBFCC\uB824 \uC704\uC7A5\uD55C\uAC83 \uAC19\uC544\uC694."
  - evidenceDatas:
    - {fileID: 11400000, guid: 9dd0f9f919c6a284ab81cb6486a7978e, type: 2}
    - {fileID: 11400000, guid: 1f68a7bd57d4e374db5019927f86d064, type: 2}
    - {fileID: 11400000, guid: 8a06f11de47e9dc4cb30e1c0cfb99c64, type: 2}
    - {fileID: 11400000, guid: 0073a29b9412ac44d81de21d562fa3af, type: 2}
    - {fileID: 11400000, guid: 6fb636ab9f40975458632b7274071248, type: 2}
    playerDescription: "\uD558\uB098\uB3C4 \uBAA8\uB974\uACA0\uC5B4"
  - evidenceDatas:
    - {fileID: 11400000, guid: 9dd0f9f919c6a284ab81cb6486a7978e, type: 2}
    playerDescription: "\uCE5C\uAD6C\uAC00 \uD2B8\uB85C\uD53C\uB85C \uBA38\uB9AC\uB97C
      \uCE5C\uAC83\uAC19\uC544."
  inputs2:
  - backgroundFacts:
    - "\uC800\uD0DD \uBC14\uB2E5\uC5D0 \uB0A8\uC790\uAC00 \uD53C\uB97C \uD758\uB9B0\uCC44
      \uC4F0\uB7EC\uC838 \uC788\uC5C8\uB2E4."
    evidenceRecords:
    - evidences:
      - {fileID: 11400000, guid: 1f68a7bd57d4e374db5019927f86d064, type: 2}
      - {fileID: 11400000, guid: 8a06f11de47e9dc4cb30e1c0cfb99c64, type: 2}
      - {fileID: 11400000, guid: 0073a29b9412ac44d81de21d562fa3af, type: 2}
      - {fileID: 11400000, guid: 9dd0f9f919c6a284ab81cb6486a7978e, type: 2}
      - {fileID: 11400000, guid: 6fb636ab9f40975458632b7274071248, type: 2}
      playerDescription: "\uC57D\uD63C\uB140\uAC00 \uBC24 10\uC2DC\uC5D0 \uC720\uC0B0\uC744
        \uB178\uB9AC\uACE0 \uCC3D\uBB38\uC744 \uAE68\uACE0 \uCE68\uC785\uD574  \uD2B8\uB85C\uD53C\uB85C
        \uBA38\uB9AC\uB97C \uB0B4\uB824\uCE5C\uAC70\uAC19\uC544\uC694. \uADF8\uB9AC\uACE0
        \uB3C8\uC744 \uBC14\uB2E5\uC5D0 \uBFCC\uB824 \uC704\uC7A5\uD55C\uAC83 \uAC19\uC544\uC694."
  inputs3:
  - deduction:
      narrative: "\"\uC88B\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08\uAE4C\uC9C0 \uB098\uC628
        \uC815\uD669\uC744 \uADF8\uB300\uB85C \uC774\uC5B4 \uBCF4\uBA74, \uC774 \uC0AC\uAC74\uC740
        \uC57D\uD63C\uB140\uAC00 \uBC24 10\uC2DC  \uBB34\uB835 \uC800\uD0DD\uC5D0
        \uB4E4\uC5B4\uC640 \uBC8C\uC778 \uC77C\uB85C \uBCF4\uB294 \uAC83\uC774 \uAC00\uC7A5
        \uC790\uC5F0\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4. \uCC3D\uBB38\uC774 \uAE68\uC838
        \uC788\uC5C8\uACE0,  \uBC14\uB2E5\uC5D0\uB294 \uB3C8\uC774 \uD769\uBFCC\uB824\uC838
        \uC788\uC5C8\uC73C\uBA70, \uBB34\uC5C7\uBCF4\uB2E4 \uD2B8\uB85C\uD53C\uC5D0
        \uD53C\uAC00 \uBB3B\uC5B4 \uC788\uC5C8\uB2E4\uB294 \uC810\uC774  \uC911\uC694\uD569\uB2C8\uB2E4.
        \uC800\uB294 \uC774\uAC78 \uB2E8\uC21C\uD55C \uC6B0\uBC1C\uC801 \uC2F8\uC6C0\uC774
        \uC544\uB2C8\uB77C, \uCE68\uC785\uACFC \uC0B4\uC778\uC744 \uD568\uAED8 \uAC10\uCD98
        \uC5F0\uCD9C\uB85C  \uBD05\uB2C8\uB2E4.  \uD50C\uB808\uC774\uC5B4\uAC00 \uB9D0\uD55C
        \uAC83\uCC98\uB7FC, \uC57D\uD63C\uB140\uB294 \uC720\uC0B0 \uC0C1\uC18D\uC744
        \uB178\uB9AC\uACE0 \uCC3D\uBB38\uC744 \uAE68\uACE0 \uB4E4\uC5B4\uC654\uACE0,
        \uC548\uC5D0\uC11C  \uD53C\uD574\uC790\uB97C \uD2B8\uB85C\uD53C\uB85C \uB0B4\uB9AC\uCCD0
        \uC4F0\uB7EC\uB728\uB838\uB2E4\uACE0 \uD310\uB2E8\uB429\uB2C8\uB2E4. \uD53C\uD574\uC790\uAC00
        \uBC14\uB2E5\uC5D0 \uD53C\uB97C \uD758\uB9AC\uBA70  \uC4F0\uB7EC\uC838 \uC788\uC5C8\uB2E4\uB294
        \uBC30\uACBD\uACFC \uD2B8\uB85C\uD53C\uC758 \uD608\uD754\uC740 \uC774 \uC218\uBC95\uACFC
        \uC798 \uB9DE\uC2B5\uB2C8\uB2E4. \uADF8 \uB4A4 \uBC14\uB2E5\uC5D0 \uB3C8\uC744 
        \uBFCC\uB9B0 \uAC83\uC740 \uB2E8\uC21C \uAC15\uB3C4 \uC0AC\uAC74\uCC98\uB7FC
        \uBCF4\uC774\uAC8C \uD558\uB824\uB294 \uC704\uC7A5\uC73C\uB85C \uD574\uC11D\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC720\uC11C\uC5D0  \uC720\uC0B0 \uC0C1\uC18D
        \uB0B4\uC6A9\uC774 \uC801\uD600 \uC788\uB2E4\uB294 \uC810\uB3C4, \uBC94\uD589
        \uB3D9\uAE30\uAC00 \uB3C8\uACFC \uC9C1\uC811 \uC5F0\uACB0\uB41C\uB2E4\uB294 
        \uD50C\uB808\uC774\uC5B4\uC758 \uAC00\uC124\uC744 \uB4B7\uBC1B\uCE68\uD569\uB2C8\uB2E4. 
        \uC57D\uD63C\uB140\uC758 \uBC18\uC9C0\uB294 \uC774 \uC0AC\uAC74\uC5D0\uC11C
        \uC644\uC804\uD788 \uBCC4\uAC1C\uC758 \uBB3C\uAC74\uC774\uB77C\uAE30\uBCF4\uB2E4,
        \uAD00\uACC4\uB97C \uBCF4\uC5EC\uC8FC\uB294 \uB2E8\uC11C\uB85C  \uBCF4\uC785\uB2C8\uB2E4.
        \uC989 \uBC94\uC778\uC740 \uD53C\uD574\uC790\uC640 \uAC00\uAE4C\uC6B4 \uC778\uBB3C\uC774\uACE0,
        \uADF8 \uAD00\uACC4\uB97C \uC774\uC6A9\uD574 \uC720\uC0B0 \uBB38\uC81C\uC5D0
        \uAC1C\uC785\uD588\uC744  \uAC00\uB2A5\uC131\uC774 \uD07D\uB2C8\uB2E4. \uC815\uB9AC\uD558\uBA74,
        \uC57D\uD63C\uB140\uAC00 \uC720\uC0B0\uC744 \uB178\uB9AC\uACE0 \uCC3D\uBB38\uC744
        \uD1B5\uD574 \uCE68\uC785\uD55C \uB4A4 \uD2B8\uB85C\uD53C\uB85C  \uD53C\uD574\uC790\uB97C
        \uACF5\uACA9\uD588\uACE0, \uB3C8\uC744 \uD769\uBFCC\uB824 \uBC94\uD589\uC744
        \uAC10\uCD98 \uC0AC\uAC74\uC785\uB2C8\uB2E4. \uC800\uB294 \uCD5C\uC885\uC801\uC73C\uB85C
        \uC57D\uD63C\uB140\uB97C  \uBC94\uC778\uC73C\uB85C \uC9C0\uBAA9\uD558\uACA0\uC2B5\uB2C8\uB2E4.\""
      culprit: "\uC57D\uD63C\uB140"
      method: "\"\uCC3D\uBB38\uC744 \uAE68\uACE0 \uCE68\uC785\uD55C \uB4A4 \uD2B8\uB85C\uD53C\uB85C
        \uD53C\uD574\uC790\uC758 \uBA38\uB9AC\uB97C \uAC00\uACA9\uD558\uACE0,  \uB3C8\uC744
        \uD769\uBFCC\uB824 \uAC15\uB3C4 \uC0AC\uAC74\uCC98\uB7FC \uC704\uC7A5\uD568\""
      motive: "\uC720\uC0B0 \uC0C1\uC18D\uC744 \uB178\uB9B0 \uAE08\uC804\uC801 \uB3D9\uAE30"
      reasoningPoints:
      - "\uCC3D\uBB38\uC774 \uAE68\uC838 \uC788\uC5B4 \uC678\uBD80 \uCE68\uC785 \uC815\uD669\uACFC
        \uD50C\uB808\uC774\uC5B4\uC758 \uCE68\uC785 \uAC00\uC124\uC774 \uC5F0\uACB0\uB41C\uB2E4."
      - "\uD2B8\uB85C\uD53C\uC5D0 \uBB3B\uC740 \uD53C\uB294 \uD53C\uD574\uC790\uB97C
        \uB454\uAE30\uB85C \uACF5\uACA9\uD588\uB2E4\uB294 \uD574\uC11D\uC744 \uB4B7\uBC1B\uCE68\uD55C\uB2E4."
      - "\uBC14\uB2E5\uC5D0 \uD769\uBFCC\uB824\uC9C4 \uB3C8\uC740 \uAC15\uB3C4\uCC98\uB7FC
        \uBCF4\uC774\uAC8C \uD558\uB824\uB294 \uC704\uC7A5\uC73C\uB85C \uBCFC \uC218
        \uC788\uB2E4."
      - "\uC720\uC11C\uC5D0 \uC720\uC0B0 \uC0C1\uC18D \uB0B4\uC6A9\uC774 \uC788\uC5B4
        \uBC94\uD589 \uB3D9\uAE30\uAC00 \uAE08\uC804 \uBB38\uC81C\uC640 \uB9DE\uB2FF\uC544
        \uC788\uB2E4."
      - "\uC57D\uD63C\uB140\uC758 \uBC18\uC9C0\uB294 \uD53C\uD574\uC790\uC640 \uAC00\uAE4C\uC6B4
        \uAD00\uACC4\uC600\uC74C\uC744 \uBCF4\uC5EC \uC8FC\uB294 \uB2E8\uC11C\uB85C
        \uC77D\uD78C\uB2E4."
    solution: {fileID: 11400000, guid: 64a9e9d6fbbbfc049a1dc12ecc214fa8, type: 2}
